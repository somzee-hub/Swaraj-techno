<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workcenter_form_swaraj" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.swaraj</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Planning and Job Work" name="swaraj_planning">
                    <group>
                        <group string="Capacity">
                            <field name="swaraj_warehouse_id"/>
                            <field name="swaraj_parallel_units"/>
                        </group>
                        <group string="Outsourcing">
                            <field name="swaraj_outsource_allowed"/>
                            <field name="swaraj_jobwork_vendor_id" invisible="not swaraj_outsource_allowed"/>
                            <field name="swaraj_jobwork_lead_days" invisible="not swaraj_outsource_allowed"/>
                            <field name="swaraj_jobwork_rate" invisible="not swaraj_outsource_allowed"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_workcenter_list_swaraj" model="ir.ui.view">
        <field name="name">mrp.workcenter.list.swaraj</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="swaraj_warehouse_id" optional="show"/>
                <field name="swaraj_parallel_units" optional="show"/>
                <field name="swaraj_outsource_allowed" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_production_form_swaraj" model="ir.ui.view">
        <field name="name">mrp.production.form.swaraj</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="project_id"/>
                <field name="swaraj_parent_mo_id" invisible="not swaraj_parent_mo_id"/>
                <field name="swaraj_level"/>
            </xpath>
        </field>
    </record>

    <record id="view_production_list_swaraj" model="ir.ui.view">
        <field name="name">mrp.production.list.swaraj</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="project_id" optional="show"/>
                <field name="swaraj_level" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
